# ================================================================
# CELL 8 - DISASTER RISK ENGINE
# ================================================================

def calculate_risk(
    temperature,
    humidity,
    rainfall,
    wind_speed,
    pressure
):

    score = 0

    risks = []

    # ------------------------------------------------------------
    # HEAT RISK
    # ------------------------------------------------------------

    if temperature >= TEMP_EXTREME:

        score += 35
        risks.append("EXTREME HEAT")

    elif temperature >= TEMP_HIGH:

        score += 20
        risks.append("HIGH TEMPERATURE")

    # ------------------------------------------------------------
    # RAINFALL RISK
    # ------------------------------------------------------------

    if rainfall >= RAIN_EXTREME:

        score += 35
        risks.append("EXTREME RAINFALL")

    elif rainfall >= RAIN_HIGH:

        score += 20
        risks.append("HEAVY RAINFALL")

    # ------------------------------------------------------------
    # WIND RISK
    # ------------------------------------------------------------

    if wind_speed >= WIND_EXTREME:

        score += 35
        risks.append("EXTREME WIND")

    elif wind_speed >= WIND_HIGH:

        score += 20
        risks.append("STRONG WIND")

    # ------------------------------------------------------------
    # HUMIDITY
    # ------------------------------------------------------------

    if humidity >= HUMIDITY_HIGH:

        score += 5
        risks.append("VERY HIGH HUMIDITY")

    # ------------------------------------------------------------
    # LOW PRESSURE
    # ------------------------------------------------------------

    if pressure < 995:

        score += 15
        risks.append("LOW ATMOSPHERIC PRESSURE")

    elif pressure < 1005:

        score += 7
        risks.append("BELOW NORMAL PRESSURE")

    # ------------------------------------------------------------
    # FINAL RISK
    # ------------------------------------------------------------

    score = min(score, 100)

    if score >= 70:

        level = "CRITICAL"

    elif score >= 45:

        level = "HIGH"

    elif score >= 20:

        level = "MODERATE"

    else:

        level = "LOW"

    return score, level, risks


