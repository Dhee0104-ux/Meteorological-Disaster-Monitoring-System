# ================================================================
# CELL 5 - GEOCODING
# ================================================================

def geocode_city(city):

    city = city.strip()

    # Check our local database first
    if city in CITY_DATABASE:
        lat, lon = CITY_DATABASE[city]
        return lat, lon

    # Open-Meteo geocoding API
    url = "https://geocoding-api.open-meteo.com/v1/search"

    params = {
        "name": city,
        "count": 1,
        "language": "en",
        "format": "json"
    }

    try:

        response = requests.get(
            url,
            params=params,
            timeout=15
        )

        response.raise_for_status()

        data = response.json()

        if "results" not in data:
            return None, None

        result = data["results"][0]

        return result["latitude"], result["longitude"]

    except Exception as e:

        print("Geocoding error:", e)

        return None, None


# ================================================================
# CELL 6 - OPEN-METEO WEATHER API
# ================================================================

def get_weather(latitude, longitude):

    url = "https://api.open-meteo.com/v1/forecast"

    params = {

        "latitude": latitude,
        "longitude": longitude,

        "current": [
            "temperature_2m",
            "relative_humidity_2m",
            "apparent_temperature",
            "precipitation",
            "rain",
            "weather_code",
            "wind_speed_10m",
            "wind_direction_10m",
            "surface_pressure"
        ],

        "hourly": [
            "temperature_2m",
            "relative_humidity_2m",
            "precipitation",
            "rain",
            "wind_speed_10m",
            "surface_pressure"
        ],

        "forecast_days": 3,

        "timezone": "auto"
    }

    response = requests.get(
        url,
        params=params,
        timeout=20
    )

    response.raise_for_status()

    return response.json()


