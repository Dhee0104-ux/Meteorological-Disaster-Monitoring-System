def get_storm_data():

    """
    Attempts to obtain active tropical cyclone
    information from NOAA/NHC public GeoJSON.

    NOAA periodically changes active storm products,
    therefore failure here does NOT stop the system.
    """

    urls = [

        "https://www.nhc.noaa.gov/CurrentStorms.json",

        "https://www.nhc.noaa.gov/xhr/CurrentStorms.json"
    ]

    for url in urls:

        try:

            response = requests.get(
                url,
                timeout=15
            )

            if response.status_code != 200:
                continue

            data = response.json()

            return data

        except Exception:

            continue

    return None


# ================================================================
# CELL 12 - EXTRACT STORMS
# ================================================================

def extract_storms(data):

    storms = []

    if not data:

        return storms

    # NOAA structure can vary
    possible_lists = []

    if isinstance(data, dict):

        for key in [
            "activeStorms",
            "storms",
            "active",
            "features"
        ]:

            if key in data:

                value = data[key]

                if isinstance(value, list):

                    possible_lists.extend(value)

    elif isinstance(data, list):

        possible_lists = data

    for storm in possible_lists:

        if not isinstance(storm, dict):
            continue

        name = (
            storm.get("name")
            or storm.get("stormName")
            or storm.get("id")
            or "Unnamed Storm"
        )

        basin = (
            storm.get("basin")
            or storm.get("basinName")
            or ""
        )

        storms.append({

            "name": name,

            "basin": basin,

            "raw": storm
        })

    return storms


# ================================================================
# CELL 13 - ML MODEL
# ================================================================

def train_risk_model():

    """
    Creates a synthetic training dataset based on
    physically motivated threshold labels.

    This is NOT a replacement for a scientific
    meteorological forecasting model.

    It demonstrates how an ML classifier can
    be integrated into the monitoring pipeline.
    """

    rng = np.random.default_rng(42)

    n = 3000

    temperature = rng.uniform(
        10,
        50,
        n
    )

    humidity = rng.uniform(
        20,
        100,
        n
    )

    rainfall = rng.uniform(
        0,
        100,
        n
    )

    wind = rng.uniform(
        0,
        120,
        n
    )

    pressure = rng.uniform(
        970,
        1035,
        n
    )

    X = np.column_stack(
        [
            temperature,
            humidity,
            rainfall,
            wind,
            pressure
        ]
    )

    labels = []

    for i in range(n):

        score, level, risks = calculate_risk(
            temperature[i],
            humidity[i],
            rainfall[i],
            wind[i],
            pressure[i]
        )

        labels.append(
            0 if level == "LOW"
            else 1 if level == "MODERATE"
            else 2 if level == "HIGH"
            else 3
        )

    model = Pipeline(

        [
            (
                "scaler",
                StandardScaler()
            ),

            (
                "classifier",
                RandomForestClassifier(
                    n_estimators=150,
                    random_state=42
                )
            )
        ]
    )

    model.fit(
        X,
        labels
    )

    return model


risk_model = train_risk_model()

print("ML disaster-risk model trained.")


# ================================================================
# CELL 14 - ML PREDICTION
# ================================================================

def ml_predict(
    temperature,
    humidity,
    rainfall,
    wind,
    pressure
):

    X = np.array(
        [
            [
                temperature,
                humidity,
                rainfall,
                wind,
                pressure
            ]
        ]
    )

    prediction = risk_model.predict(X)[0]

    probabilities = risk_model.predict_proba(X)[0]

    labels = [
        "LOW",
        "MODERATE",
        "HIGH",
        "CRITICAL"
    ]

    return (
        labels[prediction],
        probabilities
    )


