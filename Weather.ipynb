def create_forecast_dataframe(
    weather
):

    hourly = weather["hourly"]

    df = pd.DataFrame({

        "time":
            pd.to_datetime(
                hourly["time"]
            ),

        "temperature":
            hourly["temperature_2m"],

        "humidity":
            hourly[
                "relative_humidity_2m"
            ],

        "rainfall":
            hourly["precipitation"],

        "wind_speed":
            hourly["wind_speed_10m"],

        "pressure":
            hourly["surface_pressure"]
    })

    return df


# ================================================================
# CELL 18 - WEATHER CHART
# ================================================================

def create_weather_chart(
    forecast_df,
    city
):

    fig = go.Figure()

    fig.add_trace(

        go.Scatter(

            x=forecast_df["time"],

            y=forecast_df["temperature"],

            mode="lines+markers",

            name="Temperature (°C)"
        )
    )

    fig.add_trace(

        go.Scatter(

            x=forecast_df["time"],

            y=forecast_df["rainfall"],

            mode="lines+markers",

            name="Rainfall (mm)",

            yaxis="y2"
        )
    )

    fig.update_layout(

        title=
            f"Weather Forecast - {city}",

        xaxis_title="Time",

        yaxis_title=
            "Temperature (°C)",

        yaxis2=dict(

            title="Rainfall (mm)",

            overlaying="y",

            side="right"
        ),

        height=500,

        template="plotly_white"
    )

    return fig


# ================================================================
# CELL 19 - RISK MAP
# ================================================================

def create_risk_map(
    result
):

    latitude = result["latitude"]

    longitude = result["longitude"]

    risk = result["risk_level"]

    # Folium color
    if risk == "CRITICAL":

        marker_color = "red"

    elif risk == "HIGH":

        marker_color = "orange"

    elif risk == "MODERATE":

        marker_color = "blue"

    else:

        marker_color = "green"

    m = folium.Map(

        location=[
            latitude,
            longitude
        ],

        zoom_start=8,

        tiles="OpenStreetMap"
    )

    # Main location
    folium.Marker(

        [
            latitude,
            longitude
        ],

        popup=folium.Popup(

            f"""
            <b>{result['city']}</b><br>
            Weather: {result['weather']}<br>
            Temperature: {result['temperature']} °C<br>
            Rainfall: {result['rainfall']} mm<br>
            Wind: {result['wind_speed']} km/h<br>
            Risk Score: {result['risk_score']}/100<br>
            Risk Level: {risk}
            """,

            max_width=350
        ),

        tooltip=
            f"{result['city']} - {risk}",

        icon=folium.Icon(

            color=marker_color,

            icon="cloud"
        )
    ).add_to(m)

    # Risk circle
    radius = 20000

    if risk == "CRITICAL":

        radius = 50000

    elif risk == "HIGH":

        radius = 40000

    elif risk == "MODERATE":

        radius = 30000

    folium.Circle(

        location=[
            latitude,
            longitude
        ],

        radius=radius,

        popup=
            f"Risk Zone: {risk}",

        color=marker_color,

        fill=True,

        fill_opacity=0.20
    ).add_to(m)

    return m


