def get_ambee_weather(
    latitude,
    longitude
):

    if not AMBEE_API_KEY:

        return None

    url = "https://api.ambeedata.com/weather/latest/by-lat-lng"

    headers = {

        "x-api-key": AMBEE_API_KEY,

        "Content-type":
            "application/json"
    }

    params = {

        "lat": latitude,

        "lng": longitude
    }

    try:

        response = requests.get(
            url,
            headers=headers,
            params=params,
            timeout=20
        )

        if response.status_code != 200:

            print(
                "Ambee API response:",
                response.status_code
            )

            return None

        return response.json()

    except Exception as e:

        print(
            "Ambee API error:",
            e
        )

        return None


