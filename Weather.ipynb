def generate_alert(
    risk_level,
    risks,
    city
):

    if risk_level == "CRITICAL":

        return (
            f"🚨 CRITICAL DISASTER ALERT - {city}\n"
            f"Immediate attention required.\n"
            f"Detected hazards: {', '.join(risks)}"
        )

    elif risk_level == "HIGH":

        return (
            f"⚠️ HIGH RISK ALERT - {city}\n"
            f"Precautionary measures recommended.\n"
            f"Hazards: {', '.join(risks)}"
        )

    elif risk_level == "MODERATE":

        return (
            f"🟠 MODERATE RISK - {city}\n"
            f"Monitor weather conditions.\n"
            f"Potential hazards: {', '.join(risks)}"
        )

    else:

        return (
            f"🟢 LOW RISK - {city}\n"
            f"No major meteorological threat detected."
        )


